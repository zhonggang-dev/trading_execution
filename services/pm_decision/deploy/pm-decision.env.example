# Non-secret runtime configuration. The bearer token is supplied through the
# systemd credential configured in pm-decision.service, not this file.
PM_DECISION_DATABASE_PATH=/var/lib/pm-decision/idempotency.sqlite3
PM_DECISION_PORT=8787
PM_DECISION_LOG_LEVEL=INFO
PM_DECISION_MAX_REQUEST_BYTES=268435456
PM_DECISION_SQLITE_BUSY_TIMEOUT_MS=30000

# REQUIRED: there are deliberately no application defaults. Set both values
# only after Trading Execution's account/policy/global risk limits have been
# reviewed. Frozen reference sizing is v1=5 and v2=10 USD, but a smaller
# explicitly approved canary value is allowed. Leaving either blank fails boot.
PM_DECISION_V1_TARGET_NOTIONAL=
PM_DECISION_V2_TARGET_NOTIONAL=
