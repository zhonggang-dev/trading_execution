[Unit]
Description=Polymarket strategy decision v4 adapter
After=network.target
Before=trading-execution.service

[Service]
Type=simple
User=pm-decision
Group=pm-decision
WorkingDirectory=/opt/trading-execution/services/pm_decision
EnvironmentFile=/etc/pm-decision/pm-decision.env
Environment=PM_DECISION_BEARER_TOKEN_FILE=%d/api-token
LoadCredential=api-token:/etc/pm-decision/api-token
ExecStart=/opt/trading-execution/services/pm_decision/.venv/bin/pm-decision
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s

# SQLite and credential permissions. Directories need execute permission, so
# the StateDirectory is 0700 and the database itself is chmod 0600 by the app.
StateDirectory=pm-decision
StateDirectoryMode=0700
UMask=0077

# The adapter must only accept loopback traffic and cannot call the internet.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/pm-decision

[Install]
WantedBy=multi-user.target
