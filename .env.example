APP_NAME=trading_execution
APP_ENV=local
LOG_LEVEL=info

HTTP_ADDRESS=:8090
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# 本地可留空；非 local 环境至少需要 32 字节。
EXECUTION_API_TOKEN=
POSITION_EXIT_JOB_TOKEN=
# 前端只读聚合接口专用，实盘环境至少 32 字节且不能与交易/任务令牌相同。
LIVE_OPERATIONS_READ_ONLY_TOKEN=
LIVE_OPERATIONS_INTERVAL=10s
LIVE_OPERATIONS_REFRESH_TIMEOUT=8s
LIVE_OPERATIONS_MAX_SNAPSHOT_AGE=30s
LIVE_OPERATIONS_EVENT_LIMIT=50

# 非 local 环境必填。订单、幂等键、资金预占和交易历史都使用同一个 PostgreSQL。
# local 未配置时才回退到内存实现；模拟订单不会被伪装成真实成交。
TRADING_EXECUTION_DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5s

# 默认保持 paper。只有完成数据库迁移、钱包只读预检、对账和风险策略配置后，
# 才能同时把 EXECUTION_MODE=live、EXECUTION_VENUE=polymarket 与下方显式开关打开。
EXECUTION_MODE=paper
EXECUTION_VENUE=polymarket-paper
EXECUTION_ALLOW_MARKET_ORDERS=false
EXECUTION_MAX_ORDER_SIZE=1000
EXECUTION_MAX_ORDER_NOTIONAL=500
ORDER_COORDINATOR_INTERVAL=2s
ORDER_COORDINATOR_BATCH_SIZE=100

# Pull-based 10-minute decision cycle. DECISION_CYCLE_ENABLED only enables the
# snapshot/market-data/algorithm/audit path. It does not create orders unless
# the separate order-submission gate is also explicitly true.
DECISION_CYCLE_ENABLED=false
DECISION_CYCLE_ORDER_SUBMISSION_ENABLED=false
DECISION_CYCLE_ENTRY_SUBMISSION_DISABLED=false
# Production permits HTTPS, or loopback HTTP when the services share this host.
DECISION_CYCLE_PREDICTION_INFRA_URL=http://127.0.0.1:11000
DECISION_CYCLE_PREDICTION_INFRA_TOKEN=
DECISION_CYCLE_STRATEGY_URL=http://127.0.0.1:8787
DECISION_CYCLE_STRATEGY_TOKEN=
DECISION_CYCLE_INTERVAL=10m
# Each UTC boundary T is executed at T + this delay. If that window is missed,
# the runner skips it rather than replaying a stale trading decision.
DECISION_CYCLE_STARTUP_DELAY=15s
# A cycle that cannot start within this window is skipped, never replayed late.
DECISION_CYCLE_MAX_START_LATENESS=30s
DECISION_CYCLE_TIMEOUT=8m
DECISION_CYCLE_PREDICTION_LOOKBACK=3h
# One execution account may appear only once; model/strategy pairs must also be unique.
# prediction_model_id is the exact upstream snapshot model.name used for selection;
# model_id is the stable logical identity sent to Python and used by orders/risk/DB.
# If both identities are the same, prediction_model_id may be omitted.
# Verify both exact prediction_model_id values against the current PIT snapshot before deployment.
# Four-wallet topology (#0 is the existing literal account ID "main"):
# DECISION_CYCLE_BINDINGS_JSON=[{"prediction_model_id":"echo","model_id":"echo","strategy_id":"multfactor_v2","execution_account_id":"main"},{"prediction_model_id":"echo","model_id":"echo","strategy_id":"multfactor_v1","execution_account_id":"wallet-1"},{"prediction_model_id":"gemini-3.6-flash","model_id":"gemini_masked","strategy_id":"multfactor_v1","execution_account_id":"wallet-6"},{"prediction_model_id":"gemini-3.6-flash","model_id":"gemini_masked","strategy_id":"multfactor_v2","execution_account_id":"wallet-7"}]
DECISION_CYCLE_BINDINGS_JSON=[]
# Keep all four bindings in the audited production topology while excluding
# quarantined accounts from automatic submission and reconciliation work.
DECISION_CYCLE_SUBMISSION_DISABLED_ACCOUNTS_JSON=[]

# Kalshi orderbook endpoints require RSA-authenticated requests. Keep the PEM
# outside Git as a service-owned 0600 file. This gate enables market data and
# strategy/dry-run order preparation only; it does not enable real submission.
KALSHI_MARKET_DATA_ENABLED=false
KALSHI_API_URL=https://external-api.kalshi.com
KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=/run/secrets/trading_execution/kalshi.pem
KALSHI_PRIVATE_KEY_PATH=
KALSHI_REQUEST_TIMEOUT=5s

# 仅用于隔离 schema 的 PostgreSQL order/reservation/fill/ledger/decision 集成测试。
# TRADING_EXECUTION_TEST_DATABASE_URL=postgres://user:password@127.0.0.1:5432/trading_execution?sslmode=disable

# Polymarket 钱包只读连通性检查与 live runtime。真实 secrets 文件不要提交到 Git；
# 文件必须为服务用户所有的普通文件，权限 0600，不能是符号链接。
# POLYMARKET_ACCOUNTS_FILE=/run/secrets/trading_execution/wallets.json
POLYMARKET_LIVE_TRADING_ENABLED=false
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
# 仅在上线时人工核对官网仍明确属于“仅前端限制、API 不受限”后显式填写。
# 日本部署当前可填 JP；账户级 /auth/ban-status/closed-only=false 仍是强制门禁。
POLYMARKET_FRONTEND_ONLY_API_COUNTRIES=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# 必须是受信任的 Polygon HTTPS RPC；不得把带密钥的 URL 提交到 Git。
POLYGON_RPC_URL=
# OrderFilled 达到该确认数前不入资金/仓位账本，预占保持冻结；确认数不足的成交以 MINED
# finality-pending 观察持久化，对账会用其精确增量解释链上/本地差额而不阻断下单。
POLYGON_ORDER_FILLED_CONFIRMATIONS=64
# CLOB 已 CONFIRMED 的成交在 match_time 之后超过该时长仍未达到确认阈值时，
# 记为 FILL_FINALITY_STALLED + MANUAL_REVIEW（交易被丢弃/重组或 RPC head 卡住）。
POLYGON_FILL_FINALITY_MAX_AGE=30m
POLYMARKET_REQUEST_TIMEOUT=5s
POLYMARKET_STARTUP_TIMEOUT=2m
POLYMARKET_MAX_CLOCK_SKEW=3s
POLYMARKET_HEARTBEAT_INTERVAL=5s
POLYMARKET_HEARTBEAT_CALL_TIMEOUT=3s
POLYMARKET_HEARTBEAT_STALE_AFTER=9s
RECONCILIATION_INTERVAL=5m
RECONCILIATION_TRADE_LOOKBACK=48h
RECONCILIATION_POSITION_EPSILON=0.000001
RECONCILIATION_BALANCE_EPSILON=0.000001
CANCEL_FILL_FINALITY_GRACE=30s
MAX_ORDER_RECONCILE_ATTEMPTS=5
# BUY 预占优先使用 /clob-markets 官方费率曲线在保护价内的最大值；费率无法确认时退回
# worst_price * (1 + 此费率上界/10000)。live 必须显式设置，不确定时绝不按零预占。
POLYMARKET_MAX_BUY_FEE_RATE_BPS=10000
# 官方费率缓存时长，到期重新读取；读取失败沿用上次结果。
POLYMARKET_FEE_SCHEDULE_TTL=15m
# 执行层自己抓取官方盘口的最大年龄。盘口最后变动时间不参与拒单，慢市场不会因此被拒。
POLYMARKET_LATEST_BOOK_MAX_AGE=10s
POLYMARKET_WALLET_CHECK_TIMEOUT=30s
# 默认 false。只有旧钱包缺少 L2 凭证且明确允许创建/派生时才打开。
POLYMARKET_BOOTSTRAP_MISSING_API_CREDS=false
