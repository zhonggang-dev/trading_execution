APP_NAME=trading_execution
APP_ENV=local
LOG_LEVEL=info

HTTP_ADDRESS=:8090
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# 本地可留空；非 local 环境至少需要 32 字节。
EXECUTION_API_TOKEN=
POSITION_EXIT_JOB_TOKEN=
# 前端只读聚合接口专用，实盘环境至少 32 字节且不能与交易/任务令牌相同。
LIVE_OPERATIONS_READ_ONLY_TOKEN=
LIVE_OPERATIONS_INTERVAL=10s
LIVE_OPERATIONS_REFRESH_TIMEOUT=8s
LIVE_OPERATIONS_MAX_SNAPSHOT_AGE=30s
LIVE_OPERATIONS_EVENT_LIMIT=50

# 非 local 环境必填。订单、幂等键、资金预占和交易历史都使用同一个 PostgreSQL。
# local 未配置时才回退到内存实现；模拟订单不会被伪装成真实成交。
TRADING_EXECUTION_DATABASE_URL=
DATABASE_CONNECT_TIMEOUT=5s

# 默认保持 paper。只有完成数据库迁移、钱包只读预检、对账和风险策略配置后，
# 才能同时把 EXECUTION_MODE=live、EXECUTION_VENUE=polymarket 与下方显式开关打开。
EXECUTION_MODE=paper
EXECUTION_VENUE=polymarket-paper
EXECUTION_ALLOW_MARKET_ORDERS=false
EXECUTION_MAX_ORDER_SIZE=1000
EXECUTION_MAX_ORDER_NOTIONAL=500
ORDER_COORDINATOR_INTERVAL=2s
ORDER_COORDINATOR_BATCH_SIZE=100

# 仅用于隔离 schema 的 PostgreSQL order/reservation/fill/ledger 集成测试。
# TRADING_EXECUTION_TEST_DATABASE_URL=postgres://user:password@127.0.0.1:5432/trading_execution?sslmode=disable

# Polymarket 钱包只读连通性检查与 live runtime。真实 secrets 文件不要提交到 Git；
# 文件必须为服务用户所有的普通文件，权限 0600，不能是符号链接。
# POLYMARKET_ACCOUNTS_FILE=/run/secrets/trading_execution/wallets.json
POLYMARKET_LIVE_TRADING_ENABLED=false
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
# 仅在上线时人工核对官网仍明确属于“仅前端限制、API 不受限”后显式填写。
# 日本部署当前可填 JP；账户级 /auth/ban-status/closed-only=false 仍是强制门禁。
POLYMARKET_FRONTEND_ONLY_API_COUNTRIES=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# 必须是受信任的 Polygon HTTPS RPC；不得把带密钥的 URL 提交到 Git。
POLYGON_RPC_URL=
# OrderFilled 达到该确认数前不入资金/仓位账本，预占保持冻结并等待对账重试。
POLYGON_ORDER_FILLED_CONFIRMATIONS=64
POLYMARKET_REQUEST_TIMEOUT=5s
POLYMARKET_STARTUP_TIMEOUT=2m
POLYMARKET_MAX_CLOCK_SKEW=3s
POLYMARKET_HEARTBEAT_INTERVAL=5s
POLYMARKET_HEARTBEAT_CALL_TIMEOUT=3s
POLYMARKET_HEARTBEAT_STALE_AFTER=9s
RECONCILIATION_INTERVAL=5m
RECONCILIATION_TRADE_LOOKBACK=48h
RECONCILIATION_POSITION_EPSILON=0.000001
RECONCILIATION_BALANCE_EPSILON=0.000001
CANCEL_FILL_FINALITY_GRACE=30s
MAX_ORDER_RECONCILE_ATTEMPTS=5
# BUY 预占使用 worst_price * (1 + 此费率上界/10000)。live 必须显式设置。
POLYMARKET_MAX_BUY_FEE_RATE_BPS=10000
POLYMARKET_WALLET_CHECK_TIMEOUT=30s
# 默认 false。只有旧钱包缺少 L2 凭证且明确允许创建/派生时才打开。
POLYMARKET_BOOTSTRAP_MISSING_API_CREDS=false
