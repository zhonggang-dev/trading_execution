# Non-secret routing fragment for the four-wallet dry-run topology.
# Merge it into /etc/trading-execution/env only after the wallet file and the
# four matching database execution_strategy_bindings have passed preflight and
# no account has an OPEN lot owned by a pre-cutover raw model_id.
# Keep order submission disabled and the database global kill switch enabled
# for the first observed decision cycle.

POLYMARKET_ACCOUNTS_FILE=/run/secrets/trading_execution/wallets.json
# The execution service does not own strategy allocation or exposure caps.
# It still requires market orders to remain disabled for this rollout.
EXECUTION_ALLOW_MARKET_ORDERS=false
POLYMARKET_MAX_BUY_FEE_RATE_BPS=REVIEWED_NON_NEGATIVE_DECIMAL
POLYGON_ORDER_FILLED_CONFIRMATIONS=REVIEWED_POSITIVE_INTEGER
# Optional. Bounds how long a CLOB-confirmed fill may wait for the confirmation
# depth before reconciliation escalates FILL_FINALITY_STALLED. Default 30m.
POLYGON_FILL_FINALITY_MAX_AGE=30m
# Auto redeem is a separate chain-mutation gate. Keep it disabled until every
# Deposit Wallet record has relayer_api_key + relayer_api_key_address and the
# exact standard/neg-risk adapter approval/redeem canary has passed.
POLYMARKET_AUTO_REDEEM_ENABLED=false
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
POLYMARKET_AUTO_REDEEM_INTERVAL=1m
POLYMARKET_AUTO_REDEEM_RETRY_INTERVAL=30s
POLYMARKET_AUTO_REDEEM_AMBIGUITY_TIMEOUT=15m
POLYMARKET_AUTO_REDEEM_BATCH_SIZE=20
DECISION_CYCLE_ENABLED=true
DECISION_CYCLE_ORDER_SUBMISSION_ENABLED=false
DECISION_CYCLE_ENTRY_SUBMISSION_DISABLED=false
# All four accounts stay active. main/wallet-1 may be listed here to block new
# BUY entries (sell-only) while the new strategies are being observed; use any
# subset of ["main","wallet-1"], or [] to let them buy. wallet-6/wallet-7 can
# never be listed. Changing this list changes the configuration digest, so the
# preflight must be re-run.
DECISION_CYCLE_ENTRY_DISABLED_ACCOUNTS_JSON='["wallet-1"]'
DECISION_CYCLE_REQUIRE_COMPLETE_MODEL_COVERAGE=true
# Report order outcomes back to the strategy service so it can release the
# markets it occupied (docs/decision-cycle.md, "订单回报"). Empty disables it.
# The lookback is how far each pass re-reads orders; raise it once (e.g. 72h)
# to backfill rejected orders from before the first deploy.
DECISION_CYCLE_ORDER_REPORT_STRATEGY_IDS_JSON='["brier_mid_edge_once"]'
DECISION_CYCLE_ORDER_REPORT_LOOKBACK=24h
DECISION_CYCLE_INTERVAL=10m
DECISION_CYCLE_STARTUP_DELAY=15s
DECISION_CYCLE_PREDICTION_LOOKBACK=3h

# All four wallets share one logical model (deepseek_masked) and one upstream
# source model. Replace the prediction_model_id with the exact model.name in
# the current prediction_infra PIT snapshot (the Sandbox worker reports
# `v4.1 flash`); do not infer it from a vendor name.
# wallet-6/wallet-7 are fixed to multfactor_v1/multfactor_v2. main/wallet-1
# take any safe, distinct strategy_id (letter first, then letters, digits and
# ._- up to 64 chars) that is not multfactor_v1/v2. main is bound to the formal
# brier_mid_edge_once (strategy_version 1.0.0, "Brier 概率差单次建仓策略");
# wallet-1 keeps the placeholder strategy_pending_b until its formal name
# exists: then change only that value here and run
# deploy/rebind_main_wallet1.sql with the same two names.
DECISION_CYCLE_BINDINGS_JSON='[{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"brier_mid_edge_once","execution_account_id":"main"},{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"strategy_pending_b","execution_account_id":"wallet-1"},{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"multfactor_v1","execution_account_id":"wallet-6"},{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"multfactor_v2","execution_account_id":"wallet-7"}]'
# The single source model is SANDBOX (strict uppercase). Prediction may keep
# producing Echo for other consumers; Trading does not consume it.
DECISION_CYCLE_PREDICTION_SOURCE_MODES_JSON='{"v4.1 flash":"SANDBOX"}'
# No account is quarantined in this release. main/wallet-1 stay active so they
# keep reconciliation and SELL exits; their BUY restriction is the separate
# account entry gate above. Every active wallet-6/wallet-7 requires the reviewed risk-approval
# artifact and SHA described in four-wallet-rollout.md; the disabled template
# and disabled-phase evidence are not activation approval.
DECISION_CYCLE_SUBMISSION_DISABLED_ACCOUNTS_JSON='[]'
# Narrow operator switch, independent from quarantine. Listed accounts stay in
# the topology and keep reconciliation, auto redeem, the entry gate, and
# delivery of already persisted intents, but the decision cycle stops loading
# their lots and calling the strategy API for them. Set to '["main","wallet-1"]'
# while those two wallets must not be sent to the strategy (their strategy is
# disabled until the formal names are bound); '[]' (or unset)
# sends every binding again. It can never cover all four bindings.
DECISION_CYCLE_STRATEGY_DISABLED_ACCOUNTS_JSON='["wallet-1"]'
# Venue-level switch, independent from the account switches above. false stops
# every Kalshi prediction and Kalshi position lot from reaching the strategy
# (and skips Kalshi orderbook capture) while Polymarket input keeps flowing.
# true (or unset) sends both venues.
DECISION_CYCLE_KALSHI_STRATEGY_INPUT_ENABLED=true

# Treat both account arrays above as indivisible routing values. Before
# changing DECISION_CYCLE_ORDER_SUBMISSION_ENABLED, run:
# python3 deploy/four_wallet_preflight.py \
#   --env-file /etc/trading-execution/env \
#   --prediction-env-file /etc/prediction-infra/env \
#   --expected-trading-commit APPROVED_FULL_TRADING_COMMIT \
#   --expected-prediction-version APPROVED_IMMUTABLE_PREDICTION_BUILD_ID \
#   --direct-model-groups-json '{}' \
#   --write-disabled-evidence /var/lib/trading-execution/four-wallet-disabled-evidence.json
# The command requires the database kill switch to remain on and exits non-zero
# unless the wallet file contains the exact four-account set and database
# authorization state is exactly the four configured active routes. See
# deploy/four-wallet-rollout.md for the shadow-only sequence.
