# Non-secret routing fragment for the four-wallet dry-run topology.
# Merge it into /etc/trading-execution/env only after the wallet file and the
# four matching database execution_strategy_bindings have passed preflight and
# no account has an OPEN lot owned by a pre-cutover raw model_id.
# Keep order submission disabled and the database global kill switch enabled
# for the first observed decision cycle.

POLYMARKET_ACCOUNTS_FILE=/run/secrets/trading_execution/wallets.json
DECISION_CYCLE_ENABLED=true
DECISION_CYCLE_ORDER_SUBMISSION_ENABLED=false
DECISION_CYCLE_ENTRY_SUBMISSION_DISABLED=false
DECISION_CYCLE_REQUIRE_COMPLETE_MODEL_COVERAGE=true
DECISION_CYCLE_INTERVAL=10m
DECISION_CYCLE_STARTUP_DELAY=15s
DECISION_CYCLE_PREDICTION_LOOKBACK=3h

# Replace EXACT_ECHO_SNAPSHOT_MODEL_NAME with the exact model.name observed in
# the current prediction_infra PIT snapshot. Do not infer it from an LLM vendor
# name. gemini-3.6-flash is the last verified masked producer identity and must
# also be re-verified at deployment time.
DECISION_CYCLE_BINDINGS_JSON='[{"prediction_model_id":"EXACT_ECHO_SNAPSHOT_MODEL_NAME","model_id":"echo","strategy_id":"multfactor_v2","execution_account_id":"main"},{"prediction_model_id":"EXACT_ECHO_SNAPSHOT_MODEL_NAME","model_id":"echo","strategy_id":"multfactor_v1","execution_account_id":"wallet-1"},{"prediction_model_id":"gemini-3.6-flash","model_id":"gemini_masked","strategy_id":"multfactor_v1","execution_account_id":"wallet-2"},{"prediction_model_id":"gemini-3.6-flash","model_id":"gemini_masked","strategy_id":"multfactor_v2","execution_account_id":"wallet-3"}]'
# Quarantined accounts remain in the topology but do not run automatic decision,
# heartbeat, reconciliation, or intent delivery work.
DECISION_CYCLE_SUBMISSION_DISABLED_ACCOUNTS_JSON='[]'

# Treat the JSON array above as one indivisible routing value. Never append one
# wallet at a time. Before changing DECISION_CYCLE_ORDER_SUBMISSION_ENABLED, run:
# python3 deploy/four_wallet_preflight.py \
#   --env-file /etc/trading-execution/env \
#   --prediction-env-file /etc/prediction-infra/env \
#   --expected-trading-commit APPROVED_FULL_TRADING_COMMIT \
#   --expected-prediction-version APPROVED_IMMUTABLE_PREDICTION_BUILD_ID \
#   --direct-model-groups-json \
#   '{"EXACT_ECHO_SNAPSHOT_MODEL_NAME":"predict-echo-v1","gemini-3.6-flash":"predict-gemini-v1"}' \
#   --write-disabled-evidence /var/lib/trading-execution/four-wallet-disabled-evidence.json
# The command requires the database kill switch to remain on and exits non-zero
# unless the wallet file and enabled database authorizations are the exact same
# four-account set. See deploy/four-wallet-rollout.md for the two-gate sequence.
