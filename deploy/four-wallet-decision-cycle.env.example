# Non-secret routing fragment for the four-wallet dry-run topology.
# Merge it into /etc/trading-execution/env only after the wallet file and the
# four matching database execution_strategy_bindings have passed preflight and
# no account has an OPEN lot owned by a pre-cutover raw model_id.
# Keep order submission disabled and the database global kill switch enabled
# for the first observed decision cycle.

POLYMARKET_ACCOUNTS_FILE=/run/secrets/trading_execution/wallets.json
# Replace every REVIEWED value with the exact approved process-local limit.
# The rollout preflight rejects omitted values and always requires market
# orders to remain disabled.
EXECUTION_ALLOW_MARKET_ORDERS=false
EXECUTION_MAX_ORDER_SIZE=REVIEWED_POSITIVE_DECIMAL
EXECUTION_MAX_ORDER_NOTIONAL=REVIEWED_POSITIVE_DECIMAL
POLYMARKET_MAX_BUY_FEE_RATE_BPS=REVIEWED_NON_NEGATIVE_DECIMAL
POLYGON_ORDER_FILLED_CONFIRMATIONS=REVIEWED_POSITIVE_INTEGER
DECISION_CYCLE_ENABLED=true
DECISION_CYCLE_ORDER_SUBMISSION_ENABLED=false
DECISION_CYCLE_ENTRY_SUBMISSION_DISABLED=false
DECISION_CYCLE_REQUIRE_COMPLETE_MODEL_COVERAGE=true
DECISION_CYCLE_INTERVAL=10m
DECISION_CYCLE_STARTUP_DELAY=15s
DECISION_CYCLE_PREDICTION_LOOKBACK=3h
DECISION_CYCLE_MID_PRICE_LOOKBACK=REVIEWED_DURATION

# Replace EXACT_ECHO_SNAPSHOT_MODEL_NAME with the exact model.name observed in
# the current prediction_infra PIT snapshot. Do not infer it from an LLM vendor
# name. gemini-3.6-flash is the last verified masked producer identity and must
# also be re-verified at deployment time.
DECISION_CYCLE_BINDINGS_JSON='[{"prediction_model_id":"EXACT_ECHO_SNAPSHOT_MODEL_NAME","model_id":"echo","strategy_id":"multfactor_v2","execution_account_id":"main"},{"prediction_model_id":"EXACT_ECHO_SNAPSHOT_MODEL_NAME","model_id":"echo","strategy_id":"multfactor_v1","execution_account_id":"wallet-1"},{"prediction_model_id":"gemini-3.6-flash","model_id":"gemini_masked","strategy_id":"multfactor_v1","execution_account_id":"wallet-6"},{"prediction_model_id":"gemini-3.6-flash","model_id":"gemini_masked","strategy_id":"multfactor_v2","execution_account_id":"wallet-7"}]'
# This exact source contract is enforced by the Go runtime and bound into both
# preflight phases. DIRECT rows have an empty sandbox_id; SANDBOX rows require
# a non-empty sandbox_id. Values are strict uppercase and every source model
# in DECISION_CYCLE_BINDINGS_JSON must appear exactly once.
DECISION_CYCLE_PREDICTION_SOURCE_MODES_JSON='{"EXACT_ECHO_SNAPSHOT_MODEL_NAME":"DIRECT","gemini-3.6-flash":"SANDBOX"}'
# Quarantined accounts are authenticated during startup identity validation,
# but do not run heartbeat, automatic decision submission, reconciliation, or intent delivery.
# This may be ["wallet-6","wallet-7"], either explicit one-wallet subset, [],
# or ["main","wallet-1"] for the reviewed wallet-6/wallet-7-only cohort.
# Every active wallet-6/wallet-7 requires the separate reviewed risk-approval
# artifact and SHA described in four-wallet-rollout.md; the disabled template
# and disabled-phase evidence are not activation approval.
DECISION_CYCLE_SUBMISSION_DISABLED_ACCOUNTS_JSON='["wallet-6","wallet-7"]'

# Treat the JSON array above as one indivisible routing value. Never append one
# wallet at a time. Before changing DECISION_CYCLE_ORDER_SUBMISSION_ENABLED, run:
# python3 deploy/four_wallet_preflight.py \
#   --env-file /etc/trading-execution/env \
#   --prediction-env-file /etc/prediction-infra/env \
#   --expected-trading-commit APPROVED_FULL_TRADING_COMMIT \
#   --expected-prediction-version APPROVED_IMMUTABLE_PREDICTION_BUILD_ID \
#   --direct-model-groups-json \
#   '{"EXACT_ECHO_SNAPSHOT_MODEL_NAME":"predict-echo-v1"}' \
#   --write-disabled-evidence /var/lib/trading-execution/four-wallet-disabled-evidence.json
# The command requires the database kill switch to remain on and exits non-zero
# unless the wallet file contains the exact four-account set and database
# authorization state exactly matches the active/quarantined partition. See
# deploy/four-wallet-rollout.md for the two-gate sequence.
