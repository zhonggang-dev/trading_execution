[Unit]
Description=Account historical price incremental sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trading-execution
Group=trading-execution
EnvironmentFile=/etc/trading-execution/env
ExecStart=/opt/trading-execution/current/accountpricehistory incremental --max-windows 250 --timeout 45m
TimeoutStartSec=48min
Nice=10
CPUQuota=100%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
