# DeepSeek reuse profile for the existing main/wallet-1 wallets.
# Apply the reviewed walletcutover baseline first; the preflight requires its
# mode-0600 command result before this topology can start.
POLYMARKET_ACCOUNTS_FILE=/run/secrets/trading_execution/wallets.json
EXECUTION_ALLOW_MARKET_ORDERS=false
POLYMARKET_MAX_BUY_FEE_RATE_BPS=REVIEWED_NON_NEGATIVE_DECIMAL
POLYGON_ORDER_FILLED_CONFIRMATIONS=REVIEWED_POSITIVE_INTEGER

DECISION_CYCLE_TOPOLOGY=deepseek-reuse-four-wallet
DECISION_CYCLE_ENABLED=true
DECISION_CYCLE_ORDER_SUBMISSION_ENABLED=false
DECISION_CYCLE_ENTRY_SUBMISSION_DISABLED=false
# Start with both reused wallets sell-only; this may be a subset of main and
# wallet-1 after the baseline and old-lot exit evidence have been accepted.
DECISION_CYCLE_ENTRY_DISABLED_ACCOUNTS_JSON='["main","wallet-1"]'
DECISION_CYCLE_SUBMISSION_DISABLED_ACCOUNTS_JSON='[]'
DECISION_CYCLE_STRATEGY_DISABLED_ACCOUNTS_JSON='[]'
DECISION_CYCLE_REQUIRE_COMPLETE_MODEL_COVERAGE=true
DECISION_CYCLE_INTERVAL=10m
DECISION_CYCLE_STARTUP_DELAY=15s
DECISION_CYCLE_PREDICTION_LOOKBACK=3h

# One exact DeepSeek prediction model is consumed by all four routes. Replace
# the model name only after it is confirmed in the PIT prediction snapshot.
# Replace only the main/wallet-1 strategy_id values when the formal strategy
# names are approved; no source change is required. They must be distinct
# safe IDs and must not reuse multfactor_v1/multfactor_v2.
DECISION_CYCLE_BINDINGS_JSON='[{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"strategy_pending_a","execution_account_id":"main"},{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"strategy_pending_b","execution_account_id":"wallet-1"},{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"multfactor_v1","execution_account_id":"wallet-6"},{"prediction_model_id":"v4.1 flash","model_id":"deepseek_masked","strategy_id":"multfactor_v2","execution_account_id":"wallet-7"}]'
DECISION_CYCLE_PREDICTION_SOURCE_MODES_JSON='{"v4.1 flash":"SANDBOX"}'
DECISION_CYCLE_KALSHI_STRATEGY_INPUT_ENABLED=true

# Trading consumes only SANDBOX DeepSeek results in this profile. Do not add a
# Direct Redis model/group for the retained Echo producer.
# python3 deploy/four_wallet_preflight.py \
#   --topology deepseek-reuse-four-wallet \
#   --env-file /etc/trading-execution/env \
#   --prediction-env-file /etc/prediction-infra/env \
#   --cutover-baseline-evidence-json /var/lib/trading-execution/walletcutover-apply.json \
#   --direct-model-groups-json '{}' \
#   --expected-trading-commit APPROVED_FULL_TRADING_COMMIT \
#   --expected-prediction-version APPROVED_IMMUTABLE_PREDICTION_BUILD_ID \
#   --write-disabled-evidence /var/lib/trading-execution/deepseek-reuse-disabled-evidence.json
